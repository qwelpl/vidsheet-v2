#!/usr/bin/env bash
# vidsheet - local Synthesia-to-sheet-music tool.
#
#   vidsheet                       start the app, open it in your browser
#   vidsheet <url|file>            start the app attached to that source + analyze
#   vidsheet analyze <url|file>    headless: write MIDI/CSV/MusicXML to --out
#   vidsheet install | uninstall   add/remove a `vidsheet` command on your PATH
#   vidsheet -h | --help
#
# Flags: --preset fast|balanced|maximum  --out DIR (analyze)
#        --engine-port N  --web-port N  --no-open
#
# Everything runs locally, so YouTube downloads use your own residential IP and
# dodge the datacenter-IP block that cloud hosts hit.
set -euo pipefail

# Resolve this script's real directory even when invoked through a PATH symlink.
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
script_dir="$(cd -P "$(dirname "$src")" && pwd)"

# SRC = pristine source tree. Homebrew sets VIDSHEET_SRC to its read-only
# libexec; a git clone just uses the script's own directory.
SRC="${VIDSHEET_SRC:-$script_dir}"

# WORK = where we actually run. A git clone (no VIDSHEET_SRC) works in place.
# A packaged install (Homebrew sets VIDSHEET_SRC) must never write into its
# keg - even on Apple Silicon where the cellar is user-writable - because an
# upgrade would wipe it; so we sync the source into a per-user data dir and
# build the venv / node_modules there.
DATA="${VIDSHEET_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/vidsheet}"
if [ -n "${VIDSHEET_SRC:-}" ]; then
  WORK="$DATA"
else
  WORK="$SRC"
fi

ENGINE_PORT="${ENGINE_PORT:-8000}"
WEB_PORT="${WEB_PORT:-3000}"
PRESET="balanced"
OUT="out"
OPEN=1

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$src"; }

# --- helpers ---------------------------------------------------------------
is_url() { [[ "$1" =~ ^https?:// ]]; }

# Mirror the pristine source into WORK (keeping the bootstrapped venv /
# node_modules). No-op when working in place. Skipped when already in sync.
sync_source() {
  [ "$WORK" = "$SRC" ] && return 0
  mkdir -p "$WORK"
  if [ -f "$WORK/.src" ] && [ "$(cat "$WORK/.src")" = "$SRC" ]; then
    return 0
  fi
  echo "Preparing vidsheet in $WORK ..."
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete \
      --exclude '.git' --exclude 'engine/.venv' --exclude 'web/node_modules' \
      --exclude 'web/.next' "$SRC"/ "$WORK"/
  else
    cp -R "$SRC"/. "$WORK"/
  fi
  # The source may be a read-only install (brew cellar); the working copy must
  # be writable so we can build the venv / node_modules inside it.
  chmod -R u+w "$WORK"
  printf '%s' "$SRC" > "$WORK/.src"
}

# Homebrew formula that provides each required command.
_brew_formula() {
  case "$1" in
    python3.12) echo "python@3.12" ;;
    node|npm)   echo "node" ;;
    *)          echo "$1" ;;
  esac
}

# Make `brew` usable in this shell, installing Homebrew first if absent (macOS
# only). Returns non-zero if brew can't be made available.
ensure_brew() {
  command -v brew >/dev/null 2>&1 && return 0
  local b
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$b" ] && { eval "$("$b" shellenv)"; return 0; }
  done
  [ "$(uname -s)" = "Darwin" ] || return 1
  echo "Homebrew not found - installing it (may prompt for your macOS password)..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" </dev/null || return 1
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$b" ] && { eval "$("$b" shellenv)"; return 0; }
  done
  return 1
}

preflight() {
  local tools="python3.12 node npm ffmpeg yt-dlp" t missing=""
  for t in $tools; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  [ -z "$missing" ] && return 0

  # Auto-install on macOS (unless opted out). Elsewhere, just report.
  if [ "$(uname -s)" = "Darwin" ] && [ "${VIDSHEET_NO_AUTOINSTALL:-0}" != "1" ]; then
    echo "Missing tools:$missing"
    echo "Installing them with Homebrew..."
    if ensure_brew; then
      local formulae="" f
      for t in $missing; do
        f="$(_brew_formula "$t")"
        case " $formulae " in *" $f "*) ;; *) formulae="$formulae $f" ;; esac
      done
      # shellcheck disable=SC2086
      brew install $formulae || true
      hash -r 2>/dev/null || true
      missing=""
      for t in $tools; do
        command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
      done
    else
      echo "Could not set up Homebrew automatically." >&2
    fi
  fi

  if [ -n "$missing" ]; then
    echo "Still missing:$missing" >&2
    echo "Install the tools above (see README), then re-run vidsheet." >&2
    echo "On macOS: brew install python@3.12 node ffmpeg yt-dlp" >&2
    exit 1
  fi
}

bootstrap_engine() {
  if [ ! -d "$WORK/engine/.venv" ]; then
    echo "Setting up engine venv..."
    (cd "$WORK/engine" && python3.12 -m venv .venv \
      && ./.venv/bin/pip install -q -r requirements.txt yt-dlp)
  fi
}

bootstrap_web() {
  if [ ! -d "$WORK/web/node_modules" ]; then
    echo "Installing web deps..."
    (cd "$WORK/web" && npm install)
  fi
}

py() { "$WORK/engine/.venv/bin/python" "$@"; }

# Create a job on the running engine, echo its id. $1 = url|file.
create_job() {
  local source="$1" json
  if is_url "$source"; then
    json="$(curl -fsS -X POST "http://localhost:${ENGINE_PORT}/api/analyze/youtube" \
      -F "url=${source}" -F "preset=${PRESET}")"
  else
    [ -f "$source" ] || { echo "No such file: $source" >&2; exit 1; }
    json="$(curl -fsS -X POST "http://localhost:${ENGINE_PORT}/api/analyze/upload" \
      -F "file=@${source}" -F "preset=${PRESET}")"
  fi
  printf '%s' "$json" | py -c 'import sys,json; print(json.load(sys.stdin)["id"])'
}

open_browser() {
  [ "$OPEN" -eq 1 ] || return 0
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

# --- subcommands -----------------------------------------------------------
cmd_launch() {
  local source="${1:-}"
  preflight
  sync_source
  bootstrap_engine
  bootstrap_web
  echo "Starting engine on :${ENGINE_PORT} and web UI on :${WEB_PORT} ..."
  (cd "$WORK/engine" && ./.venv/bin/python -m uvicorn server:app --port "$ENGINE_PORT") &
  local api=$!
  (cd "$WORK/web" && NEXT_PUBLIC_API="http://localhost:${ENGINE_PORT}" npm run dev -- --port "$WEB_PORT") &
  local web=$!
  trap 'kill $api $web 2>/dev/null || true' EXIT INT TERM

  # Wait for the engine before creating a job / opening the browser.
  local ready=0 _
  for _ in $(seq 1 60); do
    if curl -fsS "http://localhost:${ENGINE_PORT}/api/health" >/dev/null 2>&1; then
      ready=1; break
    fi
    sleep 1
  done
  [ "$ready" -eq 1 ] || { echo "Engine did not come up." >&2; exit 1; }

  local url="http://localhost:${WEB_PORT}"
  if [ -n "$source" ]; then
    echo "Submitting ${source} ..."
    local id; id="$(create_job "$source")"
    url="${url}/?job=${id}"
    echo "Job ${id} started."
  fi
  echo "Opening ${url}"
  open_browser "$url"
  echo "Press Ctrl-C to stop."
  wait
}

cmd_analyze() {
  local source="${1:-}"
  [ -n "$source" ] || { echo "usage: vidsheet analyze <url|file>" >&2; exit 1; }
  preflight
  sync_source
  bootstrap_engine
  (cd "$WORK/engine" && exec ./.venv/bin/python cli.py analyze "$source" \
    --preset "$PRESET" --out "$OUT")
}

cmd_install() {
  local dir="$HOME/.local/bin"
  mkdir -p "$dir"
  ln -sf "$SRC/vidsheet" "$dir/vidsheet"
  echo "Linked $dir/vidsheet -> $SRC/vidsheet"
  case ":$PATH:" in
    *":$dir:"*) echo "You can now run 'vidsheet' from anywhere." ;;
    *) echo "Add this to your shell profile:  export PATH=\"$dir:\$PATH\"" ;;
  esac
}

cmd_uninstall() {
  rm -f "$HOME/.local/bin/vidsheet"
  echo "Removed $HOME/.local/bin/vidsheet"
}

# --- arg parsing -----------------------------------------------------------
first=""; second=""; pcount=0
while [ $# -gt 0 ]; do
  case "$1" in
    --preset) PRESET="$2"; shift 2 ;;
    --preset=*) PRESET="${1#*=}"; shift ;;
    --out) OUT="$2"; shift 2 ;;
    --out=*) OUT="${1#*=}"; shift ;;
    --engine-port) ENGINE_PORT="$2"; shift 2 ;;
    --web-port) WEB_PORT="$2"; shift 2 ;;
    --no-open) OPEN=0; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown flag: $1" >&2; usage; exit 1 ;;
    *)
      if [ "$pcount" -eq 0 ]; then first="$1"; else second="$1"; fi
      pcount=$((pcount + 1)); shift ;;
  esac
done

case "$first" in
  "")          cmd_launch "" ;;
  install)     cmd_install ;;
  uninstall)   cmd_uninstall ;;
  analyze)     cmd_analyze "$second" ;;
  help)        usage ;;
  *)           cmd_launch "$first" ;;   # positional treated as a source
esac
